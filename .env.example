# Copy to .env.development and .env.production.
# This build has no login/account concept and makes no calls to Jupitrr's backend — every
# variable below is optional and purely local (crash reporting, analytics, in-app purchases).

# Optional — your own Sentry DSN for crash reporting. Unset = Sentry never initializes.
EXPO_PUBLIC_SENTRY_DSN=

# Optional — your own PostHog project key for analytics. Unset = client is a no-op.
EXPO_PUBLIC_POSTHOG_KEY=

# RevenueCat — in-app subscriptions (optional; guest/free editor works without it)
# Create your own project at app.revenuecat.com, add your own store products, and
# copy the platform API keys. Entitlement identifier must exactly match RevenueCat,
# including spaces and casing.
EXPO_PUBLIC_RC_ENTITLEMENT_ID="JupitrrCut - Jump Cut Recorder Pro"
EXPO_PUBLIC_RC_IOS_API_KEY=
EXPO_PUBLIC_RC_ANDROID_API_KEY=

# Set to "true" to route through RevenueCat's Test Store instead of real App Store Connect/
# StoreKit — needed since real products can't be validated until they exist in App Store
# Connect. The Test Store key comes from a separate "App" entry in the RC dashboard.
EXPO_PUBLIC_RC_USE_TEST_STORE=
EXPO_PUBLIC_RC_TEST_STORE_API_KEY=
