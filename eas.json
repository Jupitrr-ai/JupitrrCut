{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "NODE_ENV": "development"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "prebuildCommand": "bunx expo prebuild --platform android --no-install"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "NODE_ENV": "development"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "prebuildCommand": "bunx expo prebuild --platform android --no-install"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "NODE_ENV": "production"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk",
        "prebuildCommand": "bunx expo prebuild --platform android --no-install"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "env": {
        "NODE_ENV": "production",
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "android": {
        "buildType": "app-bundle",
        "prebuildCommand": "bunx expo prebuild --platform android --no-install"
      }
    }
  }
}
